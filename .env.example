# Set false to pause automatic daily player refreshes during rollout or maintenance.
PLAYER_DATA_SYNC_ENABLED=true

# Key for AES-256-GCM encryption of user connection credentials at rest (32 bytes hex or base64)
CONNECTION_CREDENTIAL_ENCRYPTION_KEY=

# Xbox OAuth 2.0 application credentials for federated Xbox Live authentication
XBOX_OAUTH_CLIENT_ID=
XBOX_OAUTH_CLIENT_SECRET=
XBOX_OAUTH_REDIRECT_URI=http://localhost:3000/connections/callback/xbox
