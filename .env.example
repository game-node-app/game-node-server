# VARIABLES DEFINED HERE SHOULD ALSO BE DEFINED IN docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=gamenode
DB_PASS=gamenode
DB_DATABASE=gamenode
MANTICORE_URL=http://localhost:9308
DOMAIN_API=http://localhost:5000
DOMAIN_WEBSITE=http://localhost:3000
SUPERTOKENS_CORE_URI=http://localhost:3567
