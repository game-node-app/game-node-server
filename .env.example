# VARIABLES DEFINED HERE SHOULD ALSO BE DEFINED IN docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=gamenode
DB_PASS=gamenode
DB_DATABASE=gamenode
MANTICORE_URL=http://localhost:9308
DOMAIN_API=http://localhost:5000
DOMAIN_WEBSITE=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002,https://localhost,capacitor://localhost,app.gamenode://
BETTER_AUTH_SECRET=
REDIS_URL=redis://localhost:6379
BULLMQ_REDIS_URL=redis://localhost:6379
SERVER_PORT=5000
BLOG_CMS_URL=http://localhost:8055
BLOG_CMS_PUBLIC_URL=http://localhost:8055
BLOG_CMS_DELIVERY_TOKEN=
BLOG_CMS_PREVIEW_TOKEN=
CMS_SECRET=
CMS_ADMIN_EMAIL=editor@example.com
CMS_ADMIN_PASSWORD=
# Required by docker-compose.prod.yml. Production DB_HOST is the Coolify-managed MySQL internal host;
# its databases/users are provisioned once with docker/mysql/init-databases.sh (report, section 6.3).
CMS_DB_PASSWORD=
CMS_LICENSE_KEY=
BLOG_REFERENCE_API_URL=http://host.docker.internal:5000/v1
BLOG_PUBLIC_MEDIA_PATH=
STEAM_API_KEY=
PSN_NPSSO_KEY=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Epic launcher OAuth client (unofficial; used for Epic account linking)
EPIC_OAUTH_CLIENT_ID=
EPIC_OAUTH_CLIENT_SECRET=

# Set false to pause automatic daily player refreshes during rollout or maintenance.
PLAYER_DATA_SYNC_ENABLED=true

# Key for AES-256-GCM encryption of user connection credentials at rest (32 bytes hex or base64)
CONNECTION_CREDENTIAL_ENCRYPTION_KEY=

# HMAC secret for GameNode Daily image tokens (any long random string)
DAILY_IMAGE_SECRET=

# Stripe supporter subscriptions. All four values are required to enable billing; without them the
# app boots and the billing endpoints return 503. See docs/supporter-subscriptions.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUPPORTER_MONTHLY=
STRIPE_PRICE_SUPPORTER_YEARLY=
