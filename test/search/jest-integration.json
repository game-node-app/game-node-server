{
    "rootDir": "../..",
    "maxWorkers": 2,
    "workerIdleMemoryLimit": "512MB",
    "moduleFileExtensions": ["js", "json", "ts"],
    "testMatch": ["<rootDir>/test/search/**/*.integration-spec.ts"],
    "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": { "isolatedModules": false } }] },
    "testEnvironment": "node"
}
