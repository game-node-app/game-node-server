{
    "name": "game-node-server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "type": "commonjs",
    "private": true,
    "engines": {
        "node": ">=24.9.0 <25"
    },
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch | pino-pretty",
        "start:debug": "nest start --debug --watch | pino-pretty",
        "start:prod": "node --max-old-space-size=2048 dist/src/main",
        "start:dev:docker": "docker compose up --build -d --wait && yarn start:dev",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:create": "yarn run typeorm migration:create",
        "migration:generate": "yarn run typeorm migration:generate ./src/migrations/migration -d ./data-source.ts",
        "migration:run": "yarn run typeorm migration:run -d ./data-source.ts",
        "healthcheck": "node src/health/healthcheck.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:notifications": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testTimeout=120000 --testPathPatterns=\"(notifications/|statistics/statistics-reaction|comment/comment.service.integration|follow/follow.service.integration|report/report.service.integration|importer/importer-watch/importer-watch.(processor|recovery.integration).spec)\"",
        "test:statistics": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testTimeout=120000 --testPathPatterns=statistics/",
        "statistics:projection": "ts-node scripts/statistics-projection.ts",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
        "test:igdb:services:up": "docker compose -p igdb-sync-test -f test/igdb/docker-compose.yml up -d --wait",
        "test:igdb:services:down": "docker compose -p igdb-sync-test -f test/igdb/docker-compose.yml down -v",
        "test:igdb:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testTimeout=120000 --testPathPatterns=\"(sync/igdb/|game/game-repository/create/|statistics/).*\\.spec\\.ts$\"",
        "test:igdb:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/igdb/jest-integration.json --runInBand",
        "test:search:services:up": "docker compose -p search-api-test -f test/search/docker-compose.yml up -d --wait",
        "test:search:services:down": "docker compose -p search-api-test -f test/search/docker-compose.yml down -v",
        "test:search:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testPathPatterns=\"src/search/.*\\.spec\\.ts$\"",
        "test:search:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/search/jest-integration.json --runInBand",
        "igdb:catalog": "ts-node scripts/igdb-catalog.ts",
        "test:igdb:resources": "ts-node test/igdb/igdb-catalog.resources.ts",
        "seed:notifications": "ts-node scripts/seed-example-notifications.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.758.0",
        "@better-auth/core": "1.7.14",
        "@keyv/redis": "^4.4.0",
        "@liaoliaots/nestjs-redis-health": "^9.0.4",
        "@nestjs/axios": "^4.0.0",
        "@nestjs/bullmq": "^11.0.2",
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.0.11",
        "@nestjs/config": "^4.0.1",
        "@nestjs/core": "^11.0.11",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^11.0.11",
        "@nestjs/schedule": "^5.0.1",
        "@nestjs/swagger": "^11.0.6",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/typeorm": "^11.0.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.62.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
        "@opentelemetry/sdk-node": "^0.208.0",
        "@opentelemetry/sdk-trace-base": "^2.2.0",
        "@types/async-retry": "^1.4.9",
        "@types/bad-words": "^3.0.3",
        "@types/multer": "^1.4.12",
        "@xboxreplay/xboxlive-auth": "^5.1.0",
        "async-retry": "^1.3.3",
        "axios": "^1.9.0",
        "bad-words": "^4.0.0",
        "better-auth": "1.7.14",
        "better-auth-capacitor": "0.4.0",
        "bullmq": "^5.41.7",
        "cache-manager": "^6.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dayjs": "^1.11.13",
        "fuse.js": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "jsum": "^2.0.0-alpha.4",
        "jwks-rsa": "^3.1.0",
        "keyv": "^5.3.3",
        "mime-types": "^2.1.35",
        "mysql2": "^3.12.0",
        "nestjs-pino": "^4.4.1",
        "nestjs-throttler-storage-redis": "^0.5.1",
        "pino": "^10.1.0",
        "pino-http": "^11.0.0",
        "pino-opentelemetry-transport": "^1.1.0",
        "pino-pretty": "^13.1.3",
        "psn-api": "^2.11.0",
        "qs": "^6.14.0",
        "redis": "^4.7.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sanitize-html": "2.17.0",
        "sharp": "^0.33.5",
        "steamapi": "^3.0.12",
        "ts-pattern": "^5.6.2",
        "typeorm": "^0.3.27",
        "typeorm-transactional": "^0.5.0",
        "unique-username-generator": "^1.4.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.5",
        "@nestjs/schematics": "^11.0.2",
        "@nestjs/testing": "^11.0.11",
        "@types/cache-manager": "^5.0.0",
        "@types/express": "^5.0.0",
        "@types/igdb-api-node": "^5.0.3",
        "@types/jest": "30",
        "@types/jsum": "^0.1.2",
        "@types/mime-types": "^2.1.4",
        "@types/node": "24",
        "@types/sanitize-html": "^2.16.2",
        "@types/supertest": "^6.0.2",
        "@types/user-agents": "^1.0.4",
        "@typescript-eslint/eslint-plugin": "^8.26.0",
        "@typescript-eslint/parser": "^8.26.0",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.0.2",
        "eslint-plugin-prettier": "^5.2.3",
        "jest": "30.5.2",
        "prettier": "^3.5.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "29.4.15",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "^5.8.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "mjs",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": ["ts-jest", { "diagnostics": { "ignoreCodes": [151002] } }]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
